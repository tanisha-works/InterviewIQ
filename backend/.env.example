DATABASE_URL=sqlite:///./interviewiq.db
# PostgreSQL: postgresql://user:password@localhost:5432/interviewiq
WHISPER_MODEL=base
EMBEDDING_MODEL=all-MiniLM-L6-v2
UPLOAD_DIR=uploads
MAX_AUDIO_MB=25
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Replace with a unique value; generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ISSUER=interviewiq
JWT_AUDIENCE=interviewiq-client
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=30
# false is for local HTTP only; set true in production over HTTPS
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=strict
# Use /auth when calling the backend directly, or /api/auth when proxied behind /api
AUTH_COOKIE_PATH=/auth
